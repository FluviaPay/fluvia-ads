DATABASE_URL=
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=
META_SANDBOX_AD_ACCOUNT_ID=
COLOCA_API_KEY=
COLOCA_WEBHOOK_SECRET=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
ALEGRA_USER=
ALEGRA_TOKEN=
ANTHROPIC_API_KEY=

# Meta mode: mock | sandbox | live (live is only accepted when ENVIRONMENT=production)
META_MODE=
# Only used in mock mode: happy | permission-denied | rate-limited | token-expired | page-restricted
META_MOCK_SCENARIO=

# Encryption of client tokens at rest and signing of the OAuth state (generate each with
# `openssl rand -base64 32`; TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes).
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
# Shared secret for Fluvia's own backend to request connection links (Authorization: Bearer).
INTERNAL_API_TOKEN=
# Facebook Login for Business configuration id (only needed when META_MODE is not mock).
META_LOGIN_CONFIG_ID=
