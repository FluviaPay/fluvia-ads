{
  "name": "fluvia-ads",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @fluvia/api --filter @fluvia/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @fluvia/db db:generate",
    "db:migrate": "pnpm --filter @fluvia/db db:migrate",
    "deploy": "pnpm --filter @fluvia/api deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
